# Browser-visible Supabase configuration. The application reads the modern
# publishable key name; if your project still issues a legacy anon key, place
# that value here rather than adding NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/local secrets. Never rename either variable with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY is required by server-side comment mutations and the
# local two-user E2E runner; it is a server secret in Vercel.
# SUPABASE_SECRET_KEY is required only by the local seed script and must not be
# configured in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Enter UUIDs for two Auth users created in the Supabase dashboard before
# running `npm run seed:couple-users`.
COUPLE_USER_A_ID=
COUPLE_USER_A_DISPLAY_NAME=
COUPLE_USER_B_ID=
COUPLE_USER_B_DISPLAY_NAME=

# Local E2E fixture credentials. These are required by `npm run test:e2e`, not
# by the seed script. Do not configure account credentials in Vercel.
COUPLE_USER_A_EMAIL=
COUPLE_USER_A_PASSWORD=
COUPLE_USER_B_EMAIL=
COUPLE_USER_B_PASSWORD=

NEXT_PUBLIC_RELATIONSHIP_START_DATE=2024-01-01
